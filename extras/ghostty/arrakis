# Arrakis — desert night
#
# Install:
#   cp extras/ghostty/arrakis ~/.config/ghostty/themes/arrakis
# then in ~/.config/ghostty/config:
#   theme = arrakis
#
# Hand-maintained twin of lua/arrakis/palette.lua. tests/parity.lua fails
# if the two drift.

